<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction: a One UI-like visual language, written from scratch.

  What is borrowed is the idiom, not any asset: a large screen title in a tall header,
  content grouped into rounded "cards" that float on the background, rows separated by
  hairlines inside a card, summaries in an accent colour, and pill-shaped buttons.
  The original gets all of this from the unpublished SESL AndroidX forks.
-->
<resources>
    <!--
      LIGHT values. The night set lives in values-night/study_oneui.xml.

      Session 3 change: these were hard-coded white-on-dark (#24FFFFFF card, #FFFFFFFF text)
      and the app theme was Theme.AppCompat.NoActionBar, so the locations, search and
      settings screens were painted with the detail screen's dark palette whatever the system
      was doing. The original's base theme is Theme.AppCompat.DayNight.NoActionBar, and
      reference-ui/locations.png - captured on this device in light mode - shows those screens
      as a light One UI surface: grey background, white rounded rows, black text.

      The detail screen is unaffected either way, because it paints its own artwork over the
      window background. These tokens are used only by the locations, search, settings, EULA
      and message screens.

      Values traced from the original:
        col_common_bg_color        #f1f1f3 / #010102   screen background, status and nav bar
        col_common_contents_bg_color #fcfcff / #17171a card surface
        primary_text_color         #de000000 / #fafafa
        locations_add_label_type_*  #e9e9ec,#4d4d52 / #3a3a3d,#a3a3ad
    -->
    <color name="study_oneui_background">#f1f1f3</color>
    <color name="study_oneui_card">#fcfcff</color>
    <color name="study_oneui_card_pressed">#14000000</color>
    <color name="study_oneui_divider">#1f000000</color>
    <color name="study_oneui_text_primary">#de000000</color>
    <color name="study_oneui_text_secondary">#8a000000</color>
    <color name="study_oneui_accent">#387aff</color>
    <color name="study_oneui_dialog">#fcfcff</color>
    <color name="study_oneui_label_background">#e9e9ec</color>
    <color name="study_oneui_label_text">#4d4d52</color>

    <dimen name="study_oneui_card_radius">26dp</dimen>
    <dimen name="study_oneui_screen_margin">12dp</dimen>
    <dimen name="study_oneui_row_padding_horizontal">24dp</dimen>
    <dimen name="study_oneui_row_padding_vertical">16dp</dimen>

    <style name="Study.OneUi" parent="" />

    <style name="Study.OneUi.ScreenTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/study_oneui_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Study.OneUi.RowTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/study_oneui_text_primary</item>
    </style>

    <style name="Study.OneUi.RowSummary" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/study_oneui_accent</item>
    </style>

    <style name="Study.OneUi.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/study_oneui_text_secondary</item>
    </style>

    <style name="Study.OneUi.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/study_oneui_text_primary</item>
    </style>

    <style name="Study.OneUi.Headline" parent="TextAppearance.AppCompat">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/study_oneui_text_primary</item>
    </style>

    <!--
      Dialogs: a rounded sheet with inset margins, anchored low on the screen.

      The parent is DayNight, and that is the whole fix for a dialog whose text could not
      be read. `Theme.AppCompat.Dialog.Alert` is the DARK theme - AppCompat's unqualified
      `Theme.AppCompat.*` always is - so it carried a white `textColorPrimary` while
      `study_oneui_dialog` painted the sheet `#fcfcff` in day mode: white on white. The
      title and every choice were there and invisible, and in night mode the same mismatch
      ran the other way and happened to look fine, which is why it survived three passes.

      This is the same mistake pass 5 found in the app theme itself - `Theme.AppCompat`
      where `Theme.AppCompat.DayNight` was meant - left behind in the one style that did
      not inherit the correction. The surfaces and text colours either side of it already
      had their `values-night` overrides; only the parent was wrong.
    -->
    <style name="Study.OneUi.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/study_oneui_dialog_background</item>
        <item name="android:textColorPrimary">@color/study_oneui_text_primary</item>
        <item name="android:textColorSecondary">@color/study_oneui_text_secondary</item>
        <item name="colorAccent">@color/study_oneui_accent</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
</resources>
