<!--
  Educational reconstruction of the original's detail-screen dimension set.

  Session 3 change: these were previously 42 invented round numbers. They are now the
  values traced out of the APK's res/values/dimens.xml, which carries 279 `detail_*`
  entries. A measurement is a fact about the layout, not an asset, so these are recorded
  here directly with the original resource name kept in the comment so the mapping stays
  legible. See reports/resource-map.md section 3.

  Naming: `study_detail_*` mirrors an original `detail_*` entry one-for-one. The older
  `study_*` names are kept because 56 layouts already reference them, but their values
  have been corrected to the traced originals where a counterpart exists.
-->
<resources>

    <!-- ========== card surface ==========
         DetailCardConstraintLayout clips to this radius in dispatchDraw and sets
         detail_card_bg_filled as its own background in the constructor. The cards
         themselves carry no background or margin attribute in XML. -->
    <dimen name="study_detail_card_radius">22dp</dimen>                      <!-- detail_card_radius -->
    <dimen name="study_detail_card_indicator_margin_bottom">8dp</dimen>
    <dimen name="study_detail_card_page_indicator_dot_size">6dp</dimen>
    <dimen name="study_detail_card_page_indicator_dot_gap">4dp</dimen>

    <!--
      The content inset.

      GetContentAreaWidthImpl computes the usable width as
          screenWidthPx - 2 * detail_content_portrait_padding
      in portrait, so 5dp is the padding on the CONTENT ROOT, applied in code by
      DetailMainViewSetup rather than declared in a layout.

      The per-card margin on top of that is not a dimension resource at all, and it is not
      a margin either: `DetailItemDecoration` gives EVERY card `round(gap * 0.5f)` on both
      sides, where gap is detail_gap_between_cards. 5dp of list padding plus that 5dp half
      gap puts the card edge at 10dp - which is where reference-ui/home.png has it, at
      x=30px of 1080 at 450dpi (10.67dp; the original's sw384dp ramp scales both values by
      1.067 and this project traces the base `values/` set).

      study_card_margin was the stand-in for that half gap and was declared on all eleven
      top-level card layouts, which double-counted it against the decoration once the
      decoration arrived. It now belongs to the bottom floating bar only.

      This was briefly set to 0dp while tracing the hourly card, which pushed every card
      edge-to-edge and clipped the card titles; recorded here so it is not repeated.
    -->
    <dimen name="study_detail_content_portrait_padding">5dp</dimen>
    <dimen name="study_card_margin">5.5dp</dimen>

    <!--
      Past 960dp wide the content area STOPS growing.

      GetContentAreaWidthImpl returns a ratio of the screen width for every other screen
      type and this flat 840dp for Huge, so a desktop window dragged wider only gains
      margin. detail_content_width_at_huge_screen.
    -->
    <dimen name="study_detail_content_width_at_huge_screen">840dp</dimen>

    <!--
      detail_large_view_holder_gap - the gutter between the two columns on a large screen.

      Subtracted from the card list's side padding there (`pad - gap / 2`), because the
      item decoration already adds half a gutter to the outer edge of each column. Without
      that the pair measures wider than the content area it is supposed to fill.
    -->
    <dimen name="study_detail_large_view_holder_gap">10dp</dimen>

    <!--
      Uniform inner padding for the cards that have not yet been migrated to per-card
      margins.

      The original has no such value - each card declares its own, clustering at 20dp
      (detail_large_index_margin_horizontal, detail_four_contents_margin_horizontal,
      detail_two_contents_content_margin_horizontal) with the hourly card's narrative at
      25dp and its divider at 20dp. 20dp is therefore the honest stand-in until each card
      is traced individually.

      Setting this to 0 while tracing the hourly card clipped every other card's title
      against the 22dp corner radius; recorded so it is not repeated.
    -->
    <dimen name="study_card_padding">20dp</dimen>

