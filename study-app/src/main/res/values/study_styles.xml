    <!--
      The 11 condition splash themes.

      Corresponds to Weather.Theme.Splash.{Sunny,SunnyNight,PartlySunnyNight,Cloudy,Rain,
      Thunderstorm,Cold,Hot,Sandstorm,Sunrise,Sunset}, each declared by one of the 11
      DetailSplash*Activity entries in the manifest.

      Session 3 change: these used to point at two-stop XML gradients. The original sets a
      FLAT COLOUR here (col_splash_detail_bg_gradient_*). The gradient look on the real
      screen comes later, from the painted 900x900 PNG - not from the window background.
    -->
    <style name="Study.Theme.Splash" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/study_col_splash_sunny</item>
    </style>

