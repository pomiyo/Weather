<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_index_inner_view_holder.xml - one measurement tile.

  Session 3 rewrite. The previous version was a LinearLayout with android:background set in
  XML, a 132dp minHeight and 22sp values. The original is:

    * a DetailCardConstraintLayout, so the tile gets its surface and 22dp corner from the
      view's constructor like every other card on the screen;
    * 90dp minHeight, padding 14dp top / 18dp bottom / 20dp horizontal;
    * an 18dp icon and an 11sp GRAY title on one row, a Barrier under them, then an optional
      28dp value glyph and an 18sp WHITE 600 value.

  ### The Barrier is the point

  iv_icon and tv_title sit side by side and either can be the taller - a wrapped two-line
  title, or an icon on a short label. The value row hangs off a Barrier across the bottom of
  BOTH rather than off either one, so the tile lays out correctly whichever wins. Using
  Top_toBottomOf="@id/tv_title" instead would let a tall icon overlap the value.

  This is also why the tile can be minHeight rather than a fixed height: the content decides,
  and 90dp is only the floor that keeps a row of them even.
-->
<dev.local.weatherstudy.app.detail.view.StudyDetailCardConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:minHeight="@dimen/study_detail_index_height"
    android:paddingTop="@dimen/study_detail_index_padding_top"
    android:paddingBottom="@dimen/study_detail_index_padding_bottom"
    android:paddingHorizontal="@dimen/study_detail_index_padding_horizontal">

    <ImageView
        android:id="@+id/index_icon"
        android:layout_width="@dimen/study_detail_index_image_size"
        android:layout_height="@dimen/study_detail_index_image_size"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@id/small_index_barrier"
        app:layout_constraintEnd_toStartOf="@id/index_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/study_detail_white_text_color" />

    <dev.local.weatherstudy.app.common.view.StudySizeLimitedTextView
        android:id="@+id/index_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/study_detail_index_title_margin_start"
        android:textAlignment="viewStart"
        android:textAppearance="@style/Study.TextAppearance.Detail.Sec.400.Gray.11sp"
        app:layout_constraintBottom_toTopOf="@id/small_index_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/index_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- see the note above: the value row hangs off BOTH, not off either -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/small_index_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="index_icon,index_title" />

    <ImageView
        android:id="@+id/index_value_icon"
        android:layout_width="@dimen/study_detail_index_value_image_size"
        android:layout_height="@dimen/study_detail_index_value_image_size"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/index_value"
        app:layout_constraintStart_toStartOf="@id/index_icon"
        app:layout_constraintTop_toTopOf="@id/index_value"
        app:tint="@color/study_detail_white_text_color" />

    <dev.local.weatherstudy.app.common.view.StudySizeLimitedTextView
        android:id="@+id/index_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/study_detail_index_value_margin_top"
        android:textAlignment="viewStart"
        android:textAppearance="@style/Study.TextAppearance.Detail.Sec.600.White.18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/index_value_icon"
        app:layout_constraintTop_toBottomOf="@id/small_index_barrier" />

    <dev.local.weatherstudy.app.common.view.StudySizeLimitedTextView
        android:id="@+id/index_level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:textAppearance="@style/Study.TextAppearance.Detail.Sec.400.White.14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/index_value" />

</dev.local.weatherstudy.app.detail.view.StudyDetailCardConstraintLayout>
