<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_life_tips_inner_view_holder.xml
  One tip.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="@dimen/study_life_tips_width"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/life_tips_icon"
        android:layout_width="@dimen/study_insight_icon_size"
        android:layout_height="@dimen/study_insight_icon_size"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/life_tips_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Study.TextAppearance.CardValue" />

    <TextView
        android:id="@+id/life_tips_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Study.TextAppearance.CardCaption" />

</LinearLayout>
