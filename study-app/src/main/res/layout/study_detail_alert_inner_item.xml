<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_alert_inner_item.xml
  One advisory row.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/study_daily_row_padding">

    <View
        android:id="@+id/alert_severity_stripe"
        android:layout_width="@dimen/study_alert_stripe_width"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/study_card_inner_spacing"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alert_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Study.TextAppearance.CardValue" />

        <TextView
            android:id="@+id/alert_issued"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Study.TextAppearance.CardCaption" />
    </LinearLayout>

</LinearLayout>
