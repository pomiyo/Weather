<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_insight_inner_item.xml
  One insight page.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/insight_icon"
        android:layout_width="@dimen/study_insight_icon_size"
        android:layout_height="@dimen/study_insight_icon_size"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/study_card_inner_spacing"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/insight_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Study.TextAppearance.CardValue" />

        <TextView
            android:id="@+id/insight_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Study.TextAppearance.CardCaption" />

        <TextView
            android:id="@+id/insight_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Study.TextAppearance.CardCaption" />
    </LinearLayout>

</LinearLayout>
