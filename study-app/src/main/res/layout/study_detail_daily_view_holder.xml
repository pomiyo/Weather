<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_daily_view_holder.xml - the vertical list of days.

  Session 3: the rows were flush against each other. The original separates them by
  detail_daily_item_vertical_gap (18dp) and pads the card 12dp vertically / 22dp
  horizontally - so ten rows occupy roughly twice the height and read as a list rather than
  a block of text. The gap dimension had been traced and then not applied, which is the
  whole reason the card looked cramped.

  android:background and layout_margin are gone: StudyDetailCardConstraintLayout sets its
  own surface in its constructor, so declaring one here was redundant and misleading.
-->
<dev.local.weatherstudy.app.detail.view.StudyDetailCardConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/study_detail_daily_padding_vertical"
    android:paddingHorizontal="@dimen/study_detail_daily_padding_horizontal">

    <TextView
        android:id="@+id/card_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Study.TextAppearance.CardTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/daily_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/study_card_inner_spacing"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_title" />

</dev.local.weatherstudy.app.detail.view.StudyDetailCardConstraintLayout>
