<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_two_contents_view.xml
  One content slot, included twice by the News card.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/study_daily_row_padding">

    <dev.local.weatherstudy.app.detail.view.remote.StudyRemoteImageView
        android:id="@+id/content_image"
        android:layout_width="@dimen/study_content_image_size"
        android:layout_height="@dimen/study_content_image_size"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/study_card_inner_spacing"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/content_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAppearance="@style/Study.TextAppearance.CardValue" />

        <TextView
            android:id="@+id/content_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAppearance="@style/Study.TextAppearance.CardCaption" />
    </LinearLayout>

</LinearLayout>
