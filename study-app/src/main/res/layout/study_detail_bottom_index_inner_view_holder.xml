<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_bottom_index_inner_view_holder.xml
  One bottom-index cell.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="@dimen/study_bottom_index_width"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/bottom_index_icon"
        android:layout_width="@dimen/study_bottom_index_icon"
        android:layout_height="@dimen/study_bottom_index_icon"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/bottom_index_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/Study.TextAppearance.CardCaption" />

    <TextView
        android:id="@+id/bottom_index_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/Study.TextAppearance.CardValue" />

</LinearLayout>
