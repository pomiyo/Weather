<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_st_inner_view_holder.xml
  One SmartThings room row.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/study_daily_row_padding">

    <TextView
        android:id="@+id/st_room_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/Study.TextAppearance.CardValue" />

    <TextView
        android:id="@+id/st_room_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Study.TextAppearance.CardCaption" />

</LinearLayout>
