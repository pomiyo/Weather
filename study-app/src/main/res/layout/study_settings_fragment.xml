<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of the settings screen: rows grouped into cards. The
  original builds this from a SESL PreferenceFragment; the rows here are plain views so
  no fork is needed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/study_screen_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/settings_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/study_oneui_screen_margin"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
