<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_indicator_with_image_logo.xml
  Logo attribution variant.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <dev.local.weatherstudy.app.detail.view.remote.StudyRemoteImageView
        android:id="@+id/indicator_provider_logo"
        android:layout_width="@dimen/study_indicator_logo_width"
        android:layout_height="@dimen/study_indicator_logo_height"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/indicator_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="@style/Study.TextAppearance.CardCaption" />

</LinearLayout>
