<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_sun_and_moon_view_holder.xml.

  Session 3 rewrite, and the structural point of the card.

  SunAndMoon is ONE view type that renders TWO visually separate cards. The original is a
  SeslLinearLayoutCompat holding nothing but

      <include layout="@layout/detail_sun_view_holder" />
      <Space   android:layout_height="@dimen/detail_gap_between_cards" />
      <include layout="@layout/detail_moon_index_view_holder" />

  and each of those two layouts is itself a DetailCardConstraintLayout. So what looks like a
  sun card and a moon card stacked in reference-ui/home-scroll-2.png is a single RecyclerView
  item. That is the same idiom as the Index card, which is a container of tiles rather than a
  card - the pattern is worth recognising, because reading the screen and assuming one
  rounded rectangle means one view type gets both wrong.

  The previous reconstruction drew one combined card titled "Sun and moon", which is why the
  two never separated.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sun_and_moon_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/study_detail_sun_view_holder" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/study_detail_gap_between_cards" />

    <include layout="@layout/study_detail_moon_index_view_holder" />

</LinearLayout>
