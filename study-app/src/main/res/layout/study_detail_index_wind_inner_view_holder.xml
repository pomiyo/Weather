<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_index_wind_inner_view_holder.xml.

  Session 3 rewrite. All six variants were previously the same LinearLayout template with a
  132dp minHeight, an XML background and 22sp values. The four graph-bearing tiles are 190dp, more than twice the plain ones, with their own larger paddings and a StudyWindGraph filling the lower half.
-->
<dev.local.weatherstudy.app.detail.view.StudyDetailCardConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:minHeight="@dimen/study_detail_large_index_height"
    android:paddingTop="@dimen/study_detail_large_index_padding_top"
    android:paddingBottom="@dimen/study_detail_large_index_wind_padding_bottom">

    <ImageView
        android:id="@+id/index_icon"
        android:layout_width="@dimen/study_detail_index_image_size"
        android:layout_height="@dimen/study_detail_index_image_size"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/study_detail_large_index_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@id/small_index_barrier"
        app:layout_constraintEnd_toStartOf="@id/index_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/study_detail_white_text_color" />

    <dev.local.weatherstudy.app.common.view.StudySizeLimitedTextView
        android:id="@+id/index_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/study_detail_index_title_margin_start"
        app:layout_goneMarginStart="@dimen/study_detail_large_index_margin_horizontal"
        android:layout_marginEnd="@dimen/study_detail_large_index_margin_horizontal"
        android:textAlignment="viewStart"
        android:textAppearance="@style/Study.TextAppearance.Detail.Sec.400.Gray.11sp"
        app:layout_constraintBottom_toTopOf="@id/small_index_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/index_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/small_index_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="index_icon,index_title" />

    <!-- the sentence under the title: White 400 at 14sp, up to two lines -->
    <dev.local.weatherstudy.app.common.view.StudySizeLimitedTextView
        android:id="@+id/index_level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/study_detail_large_index_description_margin_top"
        android:layout_marginHorizontal="@dimen/study_detail_large_index_margin_horizontal"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textAppearance="@style/Study.TextAppearance.Detail.Sec.400.White.14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/small_index_barrier" />

    <dev.local.weatherstudy.app.detail.view.StudyWindGraph
        android:id="@+id/index_graph"
        android:layout_width="@dimen/study_detail_large_index_wind_graph_size"
        android:layout_height="@dimen/study_detail_large_index_wind_graph_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!--
      The reading is TWO views stacked inside the compass, not one line across it.

      `wind_speed_value` is 71dp wide, `wind_speed_unit` 59dp, both centred on the tile and
      both Sec.600.White.20dp. The value's -2dp bottom margin pulls the unit up against it;
      the unit's 32dp bottom margin is what holds the pair clear of the compass rim.

      This was one autosizing view bound to "7 km/h" and centred on the graph, which drew
      the text straight through the needle at any speed with two digits - see the red box
      in the session-4 review. The split is the original's, and it is also why the state
      carries valueText and unitText separately.
    -->
    <dev.local.weatherstudy.app.common.view.StudySizeLimitedTextView
        android:id="@+id/index_value"
        android:layout_width="@dimen/study_detail_large_index_wind_speed_value_area_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/Study.TextAppearance.Detail.Sec.600.White.20dp"
        android:layout_marginBottom="@dimen/study_detail_large_index_wind_speed_value_margin_bottom"
        app:layout_constraintBottom_toTopOf="@id/index_unit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <dev.local.weatherstudy.app.common.view.StudySizeLimitedTextView
        android:id="@+id/index_unit"
        android:layout_width="@dimen/study_detail_large_index_wind_speed_unit_area_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/Study.TextAppearance.Detail.Sec.600.White.20dp"
        android:layout_marginBottom="@dimen/study_detail_large_index_wind_speed_unit_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</dev.local.weatherstudy.app.detail.view.StudyDetailCardConstraintLayout>
