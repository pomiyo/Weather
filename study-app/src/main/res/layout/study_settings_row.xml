<?xml version="1.0" encoding="utf-8"?>
<!-- Educational reconstruction: one settings row - a title, and its current value in the accent colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/study_oneui_row_selectable"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/study_oneui_row_padding_horizontal"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Study.OneUi.RowTitle" />

    <TextView
        android:id="@+id/row_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/Study.OneUi.RowSummary" />
</LinearLayout>
