<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_index_visibility_inner_view_holder.xml
  Index row with no graph — a plain value readout.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/study_card_margin"
    android:background="@drawable/study_card_background"
    android:minHeight="132dp"
    android:orientation="vertical"
    android:padding="@dimen/study_card_padding">

    <TextView
        android:id="@+id/index_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textAppearance="@style/Study.TextAppearance.CardTitle" />

    <TextView
        android:id="@+id/index_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

</LinearLayout>
