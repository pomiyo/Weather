<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of detail_four_contents_view.xml
  One of the four content tiles.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/study_daily_row_padding">

    <dev.local.weatherstudy.app.detail.view.remote.StudyRemoteImageView
        android:id="@+id/content_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/study_content_tile_image_height"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/content_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAppearance="@style/Study.TextAppearance.CardCaption" />

</LinearLayout>
