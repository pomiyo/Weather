<?xml version="1.0" encoding="utf-8"?>
<!-- Educational reconstruction of locations_list_select_item: the same card, with a checkbox. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/study_oneui_screen_margin"
    android:layout_marginVertical="5dp"
    android:background="@drawable/study_oneui_card_selectable"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="24dp"
    android:paddingVertical="12dp">

    <CheckBox
        android:id="@+id/location_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:buttonTint="@color/study_oneui_text_primary" />

    <dev.local.weatherstudy.app.common.view.StudySizeLimitedTextView
        android:id="@+id/location_city"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/study_oneui_text_primary"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/location_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/study_oneui_text_primary"
        android:textSize="26sp" />
</LinearLayout>
