<?xml version="1.0" encoding="utf-8"?>
<!--
  Educational reconstruction of the consent screen (eula_fragment in the original).
  Structure: scrolling body in a card, then the agree / decline pair pinned to the bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/study_screen_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/study_oneui_screen_margin"
            android:layout_marginBottom="12dp"
            android:background="@drawable/study_oneui_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/eula_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Study.OneUi.RowTitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eula_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.25"
                android:textAppearance="@style/Study.OneUi.Body" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/eula_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <Button
            android:id="@+id/eula_decline"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/study_button_background"
            android:text="@string/study_eula_decline"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/eula_agree"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/study_button_primary_background"
            android:text="@string/study_eula_agree"
            android:textAllCaps="false"
            android:textColor="#FF1C313A"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
